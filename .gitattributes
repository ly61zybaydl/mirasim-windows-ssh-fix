# Hash-pinned source and Unix scripts must survive Windows checkouts byte-for-byte.
*.cs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmd text eol=crlf

*.exe binary
*.node binary
*.zip binary
*.xz binary
*.tgz binary
